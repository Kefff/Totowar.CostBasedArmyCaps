{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime.version": "Lua 5.1",
    "completion.autoRequire": false,
    "diagnostics.disable": [
        "lowercase-global",
        "trailing-space"
    ],
    "diagnostics.workspaceDelay": 500,
    "diagnostics.workspaceRate": 30,
    "intelliSense.traceBeSetted": true,
    "intelliSense.traceFieldInject": true,
    "intelliSense.traceLocalSet": true,
    "intelliSense.traceReturn": true,
    "workspace.ignoreSubmodules": false,
    "workspace.preloadFileSize": 1500
}
